# macOS / editor noise
.DS_Store
*.swp
*.tmp

# dependencies (npm workspaces hoist to the root; this matches at any depth)
node_modules/

# build output
dist/
dist-test/
coverage/

# owned lifecycle E2E evidence (redacted dumps/screenshots)
tests/e2e/.artifacts/

# TypeScript incremental build info
*.tsbuildinfo

# environment files (keep tracked .env.example if we ever add one)
.env
.env.*
!.env.example

# local runtime state: sockets, pids, secrets
*.sock
*.pid
*.secret
