{
  "name": "@fffattiger/pix-protocol",
  "version": "0.3.11",
  "description": "Pi Runtime Protocol v1 — frozen shared contract for host, sessiond, worker, and client",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./settings-config": {
      "types": "./dist/settings-config.d.ts",
      "import": "./dist/settings-config.js"
    },
    "./memory-settings": {
      "types": "./dist/memory-settings.d.ts",
      "import": "./dist/memory-settings.js"
    },
    "./mcp-settings": {
      "types": "./dist/mcp-settings.d.ts",
      "import": "./dist/mcp-settings.js"
    },
    "./client-diagnostics": {
      "types": "./dist/client-diagnostics.d.ts",
      "import": "./dist/client-diagnostics.js"
    },
    "./transport-limits": {
      "types": "./dist/transport-limits.d.ts",
      "import": "./dist/transport-limits.js"
    },
    "./workspace-access": {
      "types": "./dist/workspace-access.d.ts",
      "import": "./dist/workspace-access.js"
    },
    "./built-in-capabilities": {
      "types": "./dist/built-in-capabilities.d.ts",
      "import": "./dist/built-in-capabilities.js"
    },
    "./push": {
      "types": "./dist/push.d.ts",
      "import": "./dist/push.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node ../../scripts/run-node-test.mjs \"test/**/*.test.mjs\"",
    "clean": "node ../../scripts/remove-paths.mjs dist"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
