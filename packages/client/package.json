{
  "name": "@fffattiger/pix-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vite React client shell for pix (protocol-aware workstation UI)",
  "scripts": {
    "dev": "vite",
    "build:protocol": "npm run build --workspace @fffattiger/pix-protocol",
    "prebuild": "npm run build:protocol",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run build:protocol",
    "typecheck": "tsc -b --pretty false",
    "pretest": "npm run build:protocol",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node ./scripts/check-boundaries.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@fffattiger/pix-protocol": "0.1.0",
    "@fontsource/ia-writer-quattro": "5.3.0",
    "@fontsource/lilex": "5.3.0",
    "@lobehub/icons": "5.6.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.132.47",
    "katex": "0.16.47",
    "mermaid": "11.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "tailwindcss": "4.2.2",
    "typescript": "^5",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
