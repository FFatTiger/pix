{
  "name": "@fffattiger/pix-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vite React client shell for pix (protocol-aware workstation UI)",
  "scripts": {
    "dev": "vite",
    "build:protocol": "npm run build --workspace @fffattiger/pix-protocol",
    "prebuild": "npm run build:protocol",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run build:protocol",
    "typecheck": "tsc -b --pretty false",
    "pretest": "npm run build:protocol",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node ./scripts/check-boundaries.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@fffattiger/pix-protocol": "0.1.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.132.47",
    "@tanstack/react-virtual": "^3.13.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "typescript": "^5",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
