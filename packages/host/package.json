{
  "name": "@fffattiger/pix-host",
  "version": "0.1.0",
  "type": "module",
  "description": "Hono host foundation + runtime WS gateway for pix: gate, request security, static client hosting, WS upgrade seam and sessiond-backed runtime gateway",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node scripts/prebuild-deps.mjs",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "node scripts/prebuild-deps.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "pretest": "node scripts/prebuild-deps.mjs",
    "test": "npm run build && node ../../scripts/run-node-test.mjs \"test/*.test.mjs\"",
    "check:boundaries": "node ./scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "@fffattiger/pix-local-authority": "0.1.0",
    "@fffattiger/pix-pi-sdk-adapter": "0.1.0",
    "@fffattiger/pix-protocol": "0.1.0",
    "@fffattiger/pix-sessiond": "0.1.0",
    "@hono/node-server": "^1.19.0",
    "@hono/node-ws": "^1.1.0",
    "@types/ws": "^8.18.1",
    "hono": "^4.9.0",
    "mammoth": "1.12.0"
  },
  "devDependencies": {
    "@types/node": "^25",
    "typescript": "^5"
  }
}
