{
  "name": "@fffattiger/pix-local-authority",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-neutral secure-state contracts + high-assurance POSIX secure-state backend (canonical absolute paths, stable POSIX identity/principal, secure private directory + atomic durable document publication, exclusive lifetime locks) used by pix-host state. Zero runtime dependencies.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    },
    "./process": {
      "types": "./dist/process/index.d.ts",
      "import": "./dist/process/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/build-native.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "npm run build && node ./scripts/run-tests.mjs",
    "check:boundaries": "node ./scripts/check-boundaries.mjs",
    "clean": "node ../../scripts/remove-paths.mjs dist native/windows/build",
    "build:native": "node ./scripts/build-native.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
