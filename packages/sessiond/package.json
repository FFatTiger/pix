{
  "name": "@fffattiger/pix-sessiond",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative local runtime daemon for pix sessions",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js" },
    "./testing": { "types": "./dist/testing/index.d.ts", "import": "./dist/testing/index.js" },
    "./daemon": { "types": "./dist/composition/index.d.ts", "import": "./dist/composition/index.js" },
    "./control": { "types": "./dist/control.d.ts", "import": "./dist/control.js" }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "node ../../scripts/remove-paths.mjs dist dist-test",
    "build:deps": "node ./scripts/build-deps.mjs",
    "prebuild": "npm run build:deps",
    "build": "npm run clean && tsc -p tsconfig.json",
    "pretypecheck": "npm run build:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prebuild:test": "npm run build:deps",
    "test": "npm run build:test && node ../../scripts/run-node-test.mjs \"dist-test/**/*.test.js\" --test-concurrency=1 --test-timeout=120000 --test-force-exit",
    "build:test": "node ../../scripts/remove-paths.mjs dist-test && tsc -p tsconfig.test.json && node ./scripts/copy-test-fixtures.mjs",
    "precheck:boundaries": "npm run build",
    "check:boundaries": "node ./scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "@fffattiger/pix-agent-worker": "0.1.0",
    "@fffattiger/pix-local-authority": "0.1.0",
    "@fffattiger/pix-pi-sdk-adapter": "0.1.0",
    "@fffattiger/pix-protocol": "0.1.0",
    "@fffattiger/pix-runtime-core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
