{
  "name": "@fffattiger/pix",
  "version": "0.2.1",
  "private": true,
  "description": "Standalone next-generation pix product workspace: Vite Client + Hono Host + independent pi-sessiond + per-session Worker + Runtime Protocol + Pi ACL. Zero Next.js.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@earendil-works/pi-tui": "1.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-pi-claude-subagents.mjs",
    "prebuild": "node scripts/patch-pi-claude-subagents.mjs",
    "build": "node scripts/run-workspaces.mjs build",
    "typecheck": "node scripts/run-workspaces.mjs typecheck",
    "test": "node scripts/run-node-test.mjs \"scripts/**/*.test.mjs\" \"tests/e2e/helpers/*.test.mjs\" && node scripts/run-workspaces.mjs test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "start": "node scripts/product-entry.mjs start",
    "cli": "node scripts/product-entry.mjs cli",
    "test:e2e:startup": "node tests/e2e/startup.mjs",
    "test:e2e:runtime": "node tests/e2e/runtime.mjs",
    "test:e2e:sessions": "node tests/e2e/sessions-history.mjs",
    "test:e2e:lifecycle-sdk": "node tests/e2e/lifecycle-real-sdk.mjs",
    "test:e2e:lifecycle-browser": "node tests/e2e/lifecycle-browser.mjs",
    "test:e2e:multi-tab": "node tests/e2e/multi-tab-model.mjs"
  }
}
